# The image is built from a clean checkout plus whatever the build generates.
# Anything here is either local state, reproducible, or irrelevant to the build.

.git
.gitignore
.venv
venv
.coverage
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
.run
**/__pycache__
**/*.py[cod]
**/*.egg-info
.DS_Store
**/.DS_Store

# Generated by the build itself, inside the image (stage 1). A copy carried in
# from the host would make the image's assurance feed non-reproducible.
attack_lab
model_lab
provenance_lab
reports
assurance_lab/_scenarios

# Operational key material must never enter an image layer.
keys
*.pem
trust_store.json
replay.json

# Stage 2 runs npm ci and next build from scratch.
web/node_modules
web/.next
web/.env
web/*.tsbuildinfo
web/out

# Documentation and slide decks are not part of the runtime.
PPTs
