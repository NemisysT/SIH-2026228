# Local environment for the analyst platform (Module 5).
#
# ../setup.sh copies this file to web/.env on a fresh clone and never
# overwrites an existing one. Every .env* file is Git-ignored, so this
# template is the only record of what belongs in it.
#
# THERE ARE NO SECRETS IN THIS PROJECT: no API key, no token, no account, no
# database URL. The platform reads JSON reports from disk and contacts nothing.

# Next.js sends anonymous build telemetry unless this is set, and this system
# is offline by construction (docs/deployment.md § Module 5).
NEXT_TELEMETRY_DISABLED=1

# Where the platform reads its two report sources. Both default to the
# repository's own reports/ directory. Set them only to read a feed that lives
# somewhere else; they are paths, never URLs.
# CVTRUST_DEMO_DIR=../reports/analyst
# CVTRUST_LIVE_DIR=../reports/live
