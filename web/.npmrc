# @react-three/fiber 9.5.0 declares a peer range of react ">=19 <19.3", and the
# tree this project is built and verified against is react 19.3.0. npm's strict
# peer resolution refuses that combination outright, so a fresh `npm install`
# fails on a clean clone even though the installed tree is the known-good one.
#
# This makes the peer conflict a warning again, which is what it was when the
# tree was pinned. Do not "fix" it by downgrading react: that would change the
# runtime the application was validated on.
legacy-peer-deps=true
